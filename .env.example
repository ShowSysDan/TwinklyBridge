# Copy to .env and edit (install.sh does this for you on Linux). Controllers, patch and
# sACN / output settings are set in the web UI and saved in instance/bridge_config.json.
# Restart after changing this file: sudo systemctl restart twinkly-bridge

# ---- web UI -----------------------------------------------------------------
# For run.py only; the Linux service takes them from install.sh (HOST=... PORT=...).
# 127.0.0.1 = this PC only, 0.0.0.0 = every interface (needed to reach the UI from the LAN).
HOST=127.0.0.1
PORT=5120

# ---- access control (all optional; see README "Security") -------------------
# Password for the web UI and /api/ (HTTP Basic auth). Unset = no login.
# PANEL_USER=twinkly
# PANEL_PASSWORD=some-long-random-string

# Only these addresses / networks may make HTTP requests at all (comma separated).
# ALLOWED_NETWORKS=10.1.1.0/24, 192.168.10.5

# ---- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Remote syslog server for every log line (local syslog is always used on Linux).
# SYSLOG_HOST=10.1.1.20
# SYSLOG_PORT=514
# SYSLOG_PROTO=udp
# SYSLOG_FACILITY=local0

# ---- misc -------------------------------------------------------------------
# Store the bridge config somewhere other than instance/bridge_config.json
# TWINKLY_BRIDGE_CONFIG=/srv/twinkly/bridge_config.json
